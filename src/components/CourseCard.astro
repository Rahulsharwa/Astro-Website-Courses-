---
import type {Course} from '../data/site'; const {course}=Astro.props as {course:Course};
---
<a href={`/courses/${course.slug}/`} class="group flex h-full flex-col border border-brand-line bg-white p-6 transition hover:-translate-y-1 hover:border-brand-blue hover:shadow-xl focus-visible:-translate-y-1 focus-visible:border-brand-blue focus-visible:shadow-xl"><div class="mb-8 flex items-start justify-between"><span class="grid h-11 w-11 place-items-center bg-brand-blue-tint font-bold text-brand-blue">{course.icon}</span><span class="text-xs font-bold text-brand-muted transition group-hover:text-brand-blue">VIEW →</span></div><p class="eyebrow mb-2">{course.eyebrow}</p><h3 class="mb-3 text-2xl">{course.title}</h3><p class="mb-7 text-sm leading-6 text-brand-muted">{course.description}</p><div class="mt-auto flex items-center justify-between border-t border-brand-line pt-4 text-sm"><span class="font-bold text-brand-navy">{course.fee}</span><span class="font-semibold text-brand-blue">Details</span></div></a>