---
import Layout from '../../layouts/Layout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import {courses} from '../../data/site';
---
<Layout title="Computer Course Curriculum | NAC-MIT Dhamtari" description="Browse the curriculum overview for computer courses at NAC-MIT Computer Training Center in Dhamtari."><Breadcrumbs current="Curriculum"/><section class="container py-12"><div class="flex flex-wrap items-end justify-between gap-6"><div><p class="eyebrow">Course curriculum</p><h1 class="mt-3 text-5xl">See what each course covers.</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-brand-muted">The overview below is a helpful starting point. Course duration, monthly schedule and detailed module sequence should be confirmed at admission.</p></div><a class="btn btn-primary" href="/curriculum.md" download>Download overview</a></div><div class="mt-12 grid gap-5 md:grid-cols-2">{courses.map((course)=><article class="border border-brand-line p-7"><div class="flex justify-between"><p class="eyebrow">{course.shortTitle}</p><span class="font-bold text-brand-blue">{course.icon}</span></div><h2 class="mt-3 text-2xl">{course.title}</h2><ul class="mt-5 grid gap-3 text-sm leading-6 text-brand-muted">{course.curriculum.map((item)=><li>✓ {item}</li>)}</ul></article>)}</div></section></Layout>