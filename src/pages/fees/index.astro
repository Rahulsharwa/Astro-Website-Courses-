---
import Layout from '../../layouts/Layout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import {courses} from '../../data/site';
---
<Layout title="Computer Course Fees in Dhamtari | NAC-MIT" description="View available course fee information for DCA, PGDCA, Tally Prime, AI, data entry and typing at NAC-MIT."><Breadcrumbs current="Fees"/><section class="container py-12"><p class="eyebrow">Fees at a glance</p><h1 class="mt-3 text-5xl">Clear starting points for course costs.</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-brand-muted">Fees below reflect the current course information provided to NAC-MIT. Examination fees and unlisted course details should be confirmed with the institute.</p><div class="mt-12 overflow-x-auto"><table class="w-full min-w-[640px] border-collapse text-left"><thead><tr class="bg-brand-navy text-white"><th class="p-4">Course</th><th class="p-4">Eligibility</th><th class="p-4">Fee information</th><th class="p-4"></th></tr></thead><tbody>{courses.map((course)=><tr class="border-b border-brand-line"><td class="p-4 font-bold">{course.title}</td><td class="p-4 text-sm text-brand-muted">{course.eligibility}</td><td class="p-4 text-sm">{course.fee}</td><td class="p-4"><a class="btn-link" href={`/courses/${course.slug}/`}>View</a></td></tr>)}</tbody></table></div></section></Layout>